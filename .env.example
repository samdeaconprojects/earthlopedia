# Copy to .env for local dev, or set these in your host's environment config.

# Required — server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_MAPS_API_KEY=AIza...        # restrict to your domain in the Google Cloud console

# Public deploy settings
NODE_ENV=production               # disables the dev-only /tools write endpoints

# Password. Holders always get UNLIMITED use. Leave UNSET for local dev
# (gate off, everyone unlimited). Changing it logs every holder out.
SITE_PASSWORD=choose-a-strong-shared-password

# Access mode:
#   blocked (default) — whole site needs the password; no-password visitors
#                       are redirected to /login. Token counter still runs.
#   metered           — site is public; no-password visitors share the daily
#                       token pool below and are asked to log in once it's spent.
ANON_ACCESS=blocked

# Shared daily token budget for no-password visitors in 'metered' mode
# (input+output, all AI endpoints, resets 00:00 UTC). Default 200000.
ANON_DAILY_TOKEN_LIMIT=200000

# Optional
# PORT=3000
# USAGE_STATS_PATH=/var/data/usage-stats.json   # point at a Render Disk to keep the counter across redeploys
